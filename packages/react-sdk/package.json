{
  "name": "@flagcontrol/react",
  "version": "0.2.7",
  "description": "React SDK for FlagControl feature flag management",
  "license": "MIT",
  "keywords": [
    "feature",
    "flag",
    "toggle",
    "feature-flag",
    "feature-toggle",
    "flagcontrol",
    "ab-testing",
    "experimentation",
    "remote-config"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "npx tsup src/index.ts src/server.ts --format cjs,esm --dts --tsconfig tsconfig.json",
    "lint": "biome check src"
  },
  "dependencies": {
    "@flagcontrol/core": "*",
    "@flagcontrol/node": "*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.5.3",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/princecodes247/flagcontrol-js.git"
  }
}
